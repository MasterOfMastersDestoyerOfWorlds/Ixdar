      "request": "launch",
      "mainClass": "ixdar.canvas.IxdarWindow",
      "args": "model-load-canvas",
      "vmArgs": "-enableassertions -XX:+IgnoreUnrecognizedVMOptions -XstartOnFirstThread -Dsun.awt.noerasebackground=true -Dorg.lwjgl.util.DebugLoader=true",
      "env": {
        "IXDAR_ASSET_REPO_ROOT": "C:\\Code\\IxdarAssets"
