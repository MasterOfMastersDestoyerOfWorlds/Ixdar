      "cwd": "${workspaceFolder}/ixdar-app"
    },
    {
      "type": "java",
      "name": "Launch Current File",
      "request": "launch",
      "mainClass": "${file}",
      "vmArgs": "-enableassertions",
      "console": "internalConsole",
      "cwd": "${workspaceFolder}/ixdar-app"
    },
    {
      "type": "java",
      "name": "Launch Profile",
      "request": "launch",
      "mainClass": "shell.Main",
      "vmArgs": "-enableassertions -agentpath:Z:/VisualVM/visualvm_219/visualvm/lib/deployed/jdk16/windows-amd64/profilerinterface.dll=Z:\\VisualVM\\visualvm_219\\visualvm\\lib,5140",
      "cwd": "${workspaceFolder}/ixdar-app"
    },
    {
      "type": "java",
      "name": "Web (TeaVM): build",
      "request": "launch",
      "mainClass": "ixdar.canvas.WebLauncher",
      "preLaunchTask": "teavm-build"
    },
    {
      "type": "pwa-msedge",
      "request": "launch",
      "name": "Web (TeaVM): open dev server",
      "preLaunchTask": "serve-teavm",
      "url": "http://localhost:8080/",
      "webRoot": "${workspaceFolder}/target/teavm"
    },
    {
      "type": "java",
      "name": "Icosphere Save Point",
      "request": "launch",
      "mainClass": "ixdar.canvas.IxdarWindow",
      "args": "icosphere-save-point-canvas",
      "vmArgs": "-enableassertions -XX:+IgnoreUnrecognizedVMOptions -XstartOnFirstThread -Dsun.awt.noerasebackground=true -Dorg.lwjgl.util.DebugLoader=true",
      "cwd": "${workspaceFolder}/ixdar-app"
    },
    {
      "type": "java",
      "name": "Mesh Node Viewer",
      "request": "launch",
      "mainClass": "ixdar.canvas.IxdarWindow",
      "args": "mesh-viewer",
      "vmArgs": "-enableassertions -XX:+IgnoreUnrecognizedVMOptions -XstartOnFirstThread -Xmx4g -Dsun.awt.noerasebackground=true -Dorg.lwjgl.util.DebugLoader=true",
      "cwd": "${workspaceFolder}/ixdar-app"
    },
    {
      "type": "java",
      "name": "Cross Field Examination",
      "request": "launch",
      "mainClass": "ixdar.canvas.IxdarWindow",
      "args": "cross-field-exam",
      "vmArgs": [
        "${config:java.profiler.args}",
        "-enableassertions",
        "-XX:+IgnoreUnrecognizedVMOptions",
        "-XstartOnFirstThread",
        "-Xmx4g",
        "-Dsun.awt.noerasebackground=true",
        "-Dorg.lwjgl.util.DebugLoader=true",
        "-DcrossFieldScene.off=test/resources/quadlayout/figure_8/fertility_in_tri.off"
      ],
      "cwd": "${workspaceFolder}/ixdar-app"
    },
    {
      "type": "java",
      "name": "Parametrization Examination",
      "request": "launch",
      "mainClass": "ixdar.canvas.IxdarWindow",
      "args": "param-exam",
      "vmArgs": [
        "${config:java.profiler.args}",
        "-enableassertions",
        "-XX:+IgnoreUnrecognizedVMOptions",
        "-XstartOnFirstThread",
        "-Xmx4g",
        "-Dsun.awt.noerasebackground=true",
        "-Dorg.lwjgl.util.DebugLoader=true",
        "-Dparametrization.scene.off=test/resources/quadlayout/figure_8/rockerarm_in_tri.off"
      ],
      "cwd": "${workspaceFolder}/ixdar-app"
    },
    {
      "type": "java",
      "name": "Motorcycle Graph Examination",
      "request": "launch",
      "mainClass": "ixdar.canvas.IxdarWindow",
      "args": "mcg-exam",
      "vmArgs": [
        "${config:java.profiler.args}",
        "-enableassertions",
        "-XX:+IgnoreUnrecognizedVMOptions",
        "-XstartOnFirstThread",
        "-Xmx4g",
        "-Dsun.awt.noerasebackground=true",
        "-Dorg.lwjgl.util.DebugLoader=true",
        "-DmcgScene.off=test/resources/quadlayout/figure_8/rockerarm_in_tri.off",
        "-DmcgScene.alpha=15"
      ],
      "cwd": "${workspaceFolder}/ixdar-app"
    },
    {
      "type": "java",
      "name": "Quad Layout",
      "request": "launch",
      "mainClass": "ixdar.canvas.IxdarWindow",
      "args": "quad-layout",
      "vmArgs": [
        "${config:java.profiler.args}",
        "-enableassertions",
        "-XX:+IgnoreUnrecognizedVMOptions",
        "-XstartOnFirstThread",
        "-Xmx4g",
        "-Dsun.awt.noerasebackground=true",
        "-Dorg.lwjgl.util.DebugLoader=true",
        "-DquadLayoutScene.off=test/resources/quadlayout/figure_8/fertility_in_tri.off",
        "-DquadLayoutScene.alpha=15"
      ],
      "cwd": "${workspaceFolder}/ixdar-app"
    }
