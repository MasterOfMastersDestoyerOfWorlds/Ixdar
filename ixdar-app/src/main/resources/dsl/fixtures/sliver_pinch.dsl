# Sliver pinch: a zero triangle beside a sliver patch that pinches at the moved node.
carrier = mesh_disk(rings=4, angular_segments=12, radius=4.0, triangulate=true)
network = arc_network(mesh=carrier.mesh)
survivorNodeId = network_node(net=network.net, point=<0.0, 0.0, 0.0>, critical=true)
pinchNodeId = network_node(net=network.net, point=<0.0, 0.0, 1.0>)
movedNodeId = network_node(net=network.net, point=<0.0, 0.0, 2.0>)
n3 = network_node(net=network.net, point=<1.0, 0.0, 1.7320508>)
n4 = network_node(net=network.net, point=<1.7320508, 0.0, 1.0>)
n5 = network_node(net=network.net, point=<1.5, 0.0, 2.598076>)
n6 = network_node(net=network.net, point=<0.0, 0.0, 3.0>)
n7 = network_node(net=network.net, point=<-1.7320508, 0.0, 1.0>)
channelArcId = network_arc(net=network.net, from=movedNodeId.id, to=survivorNodeId.id, via1=<-0.5, 0.0, 0.8660254>)
pinchArcId = network_arc(net=network.net, from=pinchNodeId.id, to=movedNodeId.id)
directArcId = network_arc(net=network.net, from=survivorNodeId.id, to=pinchNodeId.id)
sliverOutArcId = network_arc(net=network.net, from=pinchNodeId.id, to=n3.id, length=1)
sliverFarArcId = network_arc(net=network.net, from=n3.id, to=n4.id)
sliverBackArcId = network_arc(net=network.net, from=n4.id, to=survivorNodeId.id, length=1)
farLinkArcId = network_arc(net=network.net, from=n3.id, to=n5.id)
farFlankArcId = network_arc(net=network.net, from=n5.id, to=movedNodeId.id, length=1)
fanTailArcId = network_arc(net=network.net, from=movedNodeId.id, to=n6.id, length=1)
rimArcId = network_arc(net=network.net, from=survivorNodeId.id, to=n7.id, length=1)
rimLinkArcId = network_arc(net=network.net, from=n6.id, to=n7.id, length=1)
tailLinkArcId = network_arc(net=network.net, from=n6.id, to=n5.id, length=1)
zeroTrianglePatchId = network_patch(net=network.net, a=movedNodeId.id, b=survivorNodeId.id, c=movedNodeId.id, d=movedNodeId.id, first_side=1, second_side=2, third_side=0, fourth_side=0)
sliverPatchId = network_patch(net=network.net, a=survivorNodeId.id, b=n4.id, c=n3.id, d=pinchNodeId.id)
farPatchId = network_patch(net=network.net, a=movedNodeId.id, b=pinchNodeId.id, c=n3.id, d=n5.id)
channelFlankPatchId = network_patch(net=network.net, a=survivorNodeId.id, b=movedNodeId.id, c=n6.id, d=n7.id)
tailPatchId = network_patch(net=network.net, a=movedNodeId.id, b=n5.id, c=n6.id, d=movedNodeId.id)
outerPatchId = network_patch(net=network.net, a=survivorNodeId.id, b=n7.id, c=n6.id, d=n3.id)
