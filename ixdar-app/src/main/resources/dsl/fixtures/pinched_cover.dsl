# Pinched cover: a collapse whose moved node pinches a neighbouring patch cover.
carrier = mesh_disk(rings=4, angular_segments=12, radius=4.0, triangulate=true)
network = arc_network(mesh=carrier.mesh)
survivorNodeId = network_node(net=network.net, point=<0.0, 0.0, 0.0>, critical=true)
movedNodeId = network_node(net=network.net, point=<0.0, 0.0, 2.0>)
baitFixedNodeId = network_node(net=network.net, point=<-0.5, 0.0, 0.8660254>)
absorberFarNodeId = network_node(net=network.net, point=<-0.8660254, 0.0, 0.5>)
fanFillerFarNodeId = network_node(net=network.net, point=<1.5, 0.0, 2.598076>)
channelArcId = network_arc(net=network.net, from=movedNodeId.id, to=survivorNodeId.id)
baitArcId = network_arc(net=network.net, from=baitFixedNodeId.id, to=movedNodeId.id, length=1)
baseArcId = network_arc(net=network.net, from=baitFixedNodeId.id, to=survivorNodeId.id, length=1)
farSealArcId = network_arc(net=network.net, from=baitFixedNodeId.id, to=absorberFarNodeId.id, length=1)
absorberArcId = network_arc(net=network.net, from=absorberFarNodeId.id, to=movedNodeId.id, length=1, via1=<-1.0, 0.0, 1.7320508>)
fanFillerArcId = network_arc(net=network.net, from=movedNodeId.id, to=fanFillerFarNodeId.id, length=1)
fillerSealArcId = network_arc(net=network.net, from=absorberFarNodeId.id, to=fanFillerFarNodeId.id, length=1, via1=<-1.7320508, 0.0, 1.0>, via2=<-1.5, 0.0, 2.598076>, via3=<0.0, 0.0, 3.0>)
eastSealArcId = network_arc(net=network.net, from=fanFillerFarNodeId.id, to=survivorNodeId.id, length=1)
trianglePatchId = network_patch(net=network.net, a=movedNodeId.id, b=baitFixedNodeId.id, c=survivorNodeId.id, d=movedNodeId.id)
farPatchId = network_patch(net=network.net, a=baitFixedNodeId.id, b=movedNodeId.id, c=absorberFarNodeId.id, d=baitFixedNodeId.id)
eastInnerPatchId = network_patch(net=network.net, a=movedNodeId.id, b=survivorNodeId.id, c=fanFillerFarNodeId.id, d=movedNodeId.id)
eastOuterPatchId = network_patch(net=network.net, a=movedNodeId.id, b=fanFillerFarNodeId.id, c=absorberFarNodeId.id, d=movedNodeId.id)
southPatchId = network_patch(net=network.net, a=survivorNodeId.id, b=baitFixedNodeId.id, c=absorberFarNodeId.id, d=fanFillerFarNodeId.id)
