# Plane layout: a bordered layout on a unit grid, euler characteristic one.
carrier = mesh_grid(u_tiles=16, v_tiles=16, triangulate=true)
network = arc_network(mesh=carrier.mesh)
n0 = network_node(net=network.net, point=<-8.0, 0.0, -8.0>)
n1 = network_node(net=network.net, point=<-6.0, 0.0, -8.0>)
n2 = network_node(net=network.net, point=<-8.0, 0.0, -4.0>)
n3 = network_node(net=network.net, point=<-6.0, 0.0, -4.0>)
n4 = network_node(net=network.net, point=<-8.0, 0.0, 0.0>)
n5 = network_node(net=network.net, point=<-6.0, 0.0, 0.0>)
n6 = network_node(net=network.net, point=<-4.0, 0.0, -8.0>)
n7 = network_node(net=network.net, point=<-4.0, 0.0, 0.0>)
a0 = network_arc(net=network.net, from=n0.id, to=n2.id, length=1)
a1 = network_arc(net=network.net, from=n2.id, to=n4.id, length=3)
a2 = network_arc(net=network.net, from=n1.id, to=n3.id, length=1)
a3 = network_arc(net=network.net, from=n3.id, to=n5.id, length=3)
a4 = network_arc(net=network.net, from=n6.id, to=n7.id, length=4)
a5 = network_arc(net=network.net, from=n0.id, to=n1.id, length=1)
a6 = network_arc(net=network.net, from=n2.id, to=n3.id, length=1)
a7 = network_arc(net=network.net, from=n4.id, to=n5.id, length=1)
a8 = network_arc(net=network.net, from=n1.id, to=n6.id)
a9 = network_arc(net=network.net, from=n5.id, to=n7.id)
p0 = network_patch(net=network.net, a=n0.id, b=n2.id, c=n3.id, d=n1.id)
p1 = network_patch(net=network.net, a=n2.id, b=n4.id, c=n5.id, d=n3.id)
p2 = network_patch(net=network.net, a=n1.id, b=n5.id, c=n7.id, d=n6.id)
