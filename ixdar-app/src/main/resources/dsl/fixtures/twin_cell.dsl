# Twin cell: an all-zero web with parallel arcs and a bigon island.
carrier = mesh_disk(rings=4, angular_segments=12, radius=4.0, triangulate=true)
network = arc_network(mesh=carrier.mesh)
survivorNodeId = network_node(net=network.net, point=<0.0, 0.0, 0.0>, critical=true)
movedNodeId = network_node(net=network.net, point=<0.0, 0.0, 2.0>)
islandNodeId = network_node(net=network.net, point=<-0.8660254, 0.0, 0.5>)
eastFanNodeId = network_node(net=network.net, point=<1.0, 0.0, 1.7320508>)
outerFanNodeId = network_node(net=network.net, point=<1.5, 0.0, 2.598076>)
channelArcId = network_arc(net=network.net, from=movedNodeId.id, to=survivorNodeId.id)
parallelArcId = network_arc(net=network.net, from=movedNodeId.id, to=survivorNodeId.id, via1=<-2.0, 0.0, 0.0>)
inArcId = network_arc(net=network.net, from=survivorNodeId.id, to=islandNodeId.id)
tornArcId = network_arc(net=network.net, from=islandNodeId.id, to=survivorNodeId.id, via1=<-0.5, 0.0, 0.8660254>)
eastFanArcId = network_arc(net=network.net, from=movedNodeId.id, to=eastFanNodeId.id)
eastSealArcId = network_arc(net=network.net, from=eastFanNodeId.id, to=survivorNodeId.id)
outerFanArcId = network_arc(net=network.net, from=movedNodeId.id, to=outerFanNodeId.id)
outerSealArcId = network_arc(net=network.net, from=outerFanNodeId.id, to=survivorNodeId.id, via1=<2.598076, 0.0, 1.5>, via2=<1.7320508, 0.0, 1.0>, via3=<0.8660254, 0.0, 0.5>)
westCellPatchId = network_patch(net=network.net, a=movedNodeId.id, b=survivorNodeId.id, c=islandNodeId.id, d=survivorNodeId.id)
islandPatchId = network_patch(net=network.net, a=survivorNodeId.id, b=islandNodeId.id, c=survivorNodeId.id, d=survivorNodeId.id, first_side=1, second_side=1, third_side=0, fourth_side=0)
eastInnerPatchId = network_patch(net=network.net, a=movedNodeId.id, b=survivorNodeId.id, c=eastFanNodeId.id, d=movedNodeId.id)
eastOuterPatchId = network_patch(net=network.net, a=movedNodeId.id, b=eastFanNodeId.id, c=survivorNodeId.id, d=outerFanNodeId.id)
southCellPatchId = network_patch(net=network.net, a=movedNodeId.id, b=outerFanNodeId.id, c=survivorNodeId.id, d=movedNodeId.id)
