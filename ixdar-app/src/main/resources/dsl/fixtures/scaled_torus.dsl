# Scaled torus: the torus layout on a refined carrier; callers override
# carrier.major_segments and carrier.minor_segments per scale (x1: 12x8).
carrier = torus(major_segments=48, minor_segments=32, triangulate=true)
network = arc_network(mesh=carrier.mesh)
n0 = network_node(net=network.net, point=<1.35, 0.0, 0.0>)
n1 = network_node(net=network.net, point=<1.0, 0.35, 0.0>)
n2 = network_node(net=network.net, point=<0.675, 0.0, 1.1691343>)
n3 = network_node(net=network.net, point=<0.5, 0.35, 0.8660254>)
n4 = network_node(net=network.net, point=<-0.675, 0.0, 1.1691343>)
n5 = network_node(net=network.net, point=<-0.5, 0.35, 0.8660254>)
n6 = network_node(net=network.net, point=<-0.675, 0.0, -1.1691343>)
n7 = network_node(net=network.net, point=<-0.5, 0.35, -0.8660254>)
n8 = network_node(net=network.net, point=<0.65, 0.0, 0.0>)
n9 = network_node(net=network.net, point=<-0.325, 0.0, 0.5629165>)
n10 = network_node(net=network.net, point=<-0.32500002, 0.0, -0.5629165>)
a0 = network_arc(net=network.net, from=n0.id, to=n2.id, length=1)
a1 = network_arc(net=network.net, from=n2.id, to=n4.id, length=1)
a2 = network_arc(net=network.net, from=n4.id, to=n6.id, length=3)
a3 = network_arc(net=network.net, from=n6.id, to=n0.id, length=2)
a4 = network_arc(net=network.net, from=n1.id, to=n3.id, length=1)
a5 = network_arc(net=network.net, from=n3.id, to=n5.id, length=1)
a6 = network_arc(net=network.net, from=n5.id, to=n7.id, length=3, via1=<-1.0, 0.35, 0.0>)
a7 = network_arc(net=network.net, from=n7.id, to=n1.id, length=2, via1=<0.5, 0.35, -0.8660254>)
a8 = network_arc(net=network.net, from=n8.id, to=n9.id, length=2)
a9 = network_arc(net=network.net, from=n9.id, to=n10.id, length=3)
a10 = network_arc(net=network.net, from=n10.id, to=n8.id, length=2)
a11 = network_arc(net=network.net, from=n0.id, to=n1.id, length=2)
a12 = network_arc(net=network.net, from=n2.id, to=n3.id, length=2)
a13 = network_arc(net=network.net, from=n4.id, to=n5.id, length=2)
a14 = network_arc(net=network.net, from=n6.id, to=n7.id, length=2)
a15 = network_arc(net=network.net, from=n1.id, to=n8.id)
a16 = network_arc(net=network.net, from=n5.id, to=n9.id)
a17 = network_arc(net=network.net, from=n7.id, to=n10.id)
a18 = network_arc(net=network.net, from=n8.id, to=n0.id, length=1, via1=<1.0, -0.35, 0.0>)
a19 = network_arc(net=network.net, from=n9.id, to=n4.id, length=1, via1=<-0.5, -0.35, 0.8660254>)
a20 = network_arc(net=network.net, from=n10.id, to=n6.id, length=1, via1=<-0.5, -0.35, -0.8660254>)
p0 = network_patch(net=network.net, a=n0.id, b=n1.id, c=n3.id, d=n2.id)
p1 = network_patch(net=network.net, a=n2.id, b=n3.id, c=n5.id, d=n4.id)
p2 = network_patch(net=network.net, a=n4.id, b=n5.id, c=n7.id, d=n6.id)
p3 = network_patch(net=network.net, a=n6.id, b=n7.id, c=n1.id, d=n0.id)
p4 = network_patch(net=network.net, a=n1.id, b=n8.id, c=n9.id, d=n5.id)
p5 = network_patch(net=network.net, a=n5.id, b=n9.id, c=n10.id, d=n7.id)
p6 = network_patch(net=network.net, a=n7.id, b=n10.id, c=n8.id, d=n1.id)
p7 = network_patch(net=network.net, a=n8.id, b=n0.id, c=n4.id, d=n9.id)
p8 = network_patch(net=network.net, a=n9.id, b=n4.id, c=n6.id, d=n10.id)
p9 = network_patch(net=network.net, a=n10.id, b=n6.id, c=n0.id, d=n8.id)
