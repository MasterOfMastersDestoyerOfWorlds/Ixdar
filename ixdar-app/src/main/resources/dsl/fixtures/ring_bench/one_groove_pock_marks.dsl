# Ring fit, one groove among pock marks: the torus of one_groove, its tube pinched in one cross-section
# at +x, and eight round pits pressed into the tube elsewhere. The pits differ in width (0.22 to 0.4)
# and depth (0.2 to 0.6 of the groove's pinch scale, against the groove's 0.3), so six are deeper than
# the groove. Four lie between the ring and the groove (45, 62 and 72 degrees round the torus, and 30 on
# the inside of the tube), one sits just beside the groove (18 degrees, below), and three lie elsewhere
# (115, 140 and -60 degrees). A ring drawn a quarter of the torus away should be fitted into the groove
# and ignore every pit.
carrier = torus(major_radius=2.0, minor_radius=0.5, major_segments=160, minor_segments=40, triangulate=true)

pos = input_position()
xyz = separate_xyz(vector=pos.vector)
x2 = float_math(operation=MULTIPLY, a=xyz.x, b=xyz.x)
z2 = float_math(operation=MULTIPLY, a=xyz.z, b=xyz.z)
rho2 = float_math(operation=ADD, a=x2.result, b=z2.result)
rho = float_math(operation=SQRT, a=rho2.result)
# Unit direction from the axis, and the vector from the tube's centre circle (radius 2).
ux = float_math(operation=DIVIDE, a=xyz.x, b=rho.result)
uz = float_math(operation=DIVIDE, a=xyz.z, b=rho.result)
cx = float_math(operation=MULTIPLY, a=ux.result, b=2.0)
cz = float_math(operation=MULTIPLY, a=uz.result, b=2.0)
tx = float_math(operation=SUBTRACT, a=xyz.x, b=cx.result)
tz = float_math(operation=SUBTRACT, a=xyz.z, b=cz.result)

# --- Groove at +x: 1 at its bottom, 0 from 0.3 along the torus away ---
a_dx = float_math(operation=SUBTRACT, a=ux.result, b=1.0)
a_dx2 = float_math(operation=MULTIPLY, a=a_dx.result, b=a_dx.result)
a_d2 = float_math(operation=ADD, a=a_dx2.result, b=float_math(operation=MULTIPLY, a=uz.result, b=uz.result).result)
a_t2 = float_math(operation=MULTIPLY, a=a_d2.result, b=44.444444)
a_s = float_math(operation=MAXIMUM, a=float_math(operation=SUBTRACT, a=1.0, b=a_t2.result).result, b=0.0)
pinch = float_math(operation=MULTIPLY, a=a_s.result, b=a_s.result)

# --- Pits: each 1 at its centre on the tube, 0 from its width away, times its depth ---
p1_dx = float_math(operation=SUBTRACT, a=xyz.x, b=1.767767)
p1_dy = float_math(operation=SUBTRACT, a=xyz.y, b=0.0)
p1_dz = float_math(operation=SUBTRACT, a=xyz.z, b=1.767767)
p1_d2 = float_math(operation=ADD, a=float_math(operation=ADD, a=float_math(operation=MULTIPLY, a=p1_dx.result, b=p1_dx.result).result, b=float_math(operation=MULTIPLY, a=p1_dy.result, b=p1_dy.result).result).result, b=float_math(operation=MULTIPLY, a=p1_dz.result, b=p1_dz.result).result)
p1_s = float_math(operation=MAXIMUM, a=float_math(operation=SUBTRACT, a=1.0, b=float_math(operation=MULTIPLY, a=p1_d2.result, b=11.111111).result).result, b=0.0)
p1 = float_math(operation=MULTIPLY, a=float_math(operation=MULTIPLY, a=p1_s.result, b=p1_s.result).result, b=0.5)
p2_dx = float_math(operation=SUBTRACT, a=xyz.x, b=0.938943)
p2_dy = float_math(operation=SUBTRACT, a=xyz.y, b=0.5)
p2_dz = float_math(operation=SUBTRACT, a=xyz.z, b=1.765895)
p2_d2 = float_math(operation=ADD, a=float_math(operation=ADD, a=float_math(operation=MULTIPLY, a=p2_dx.result, b=p2_dx.result).result, b=float_math(operation=MULTIPLY, a=p2_dy.result, b=p2_dy.result).result).result, b=float_math(operation=MULTIPLY, a=p2_dz.result, b=p2_dz.result).result)
p2_s = float_math(operation=MAXIMUM, a=float_math(operation=SUBTRACT, a=1.0, b=float_math(operation=MULTIPLY, a=p2_d2.result, b=6.25).result).result, b=0.0)
p2 = float_math(operation=MULTIPLY, a=float_math(operation=MULTIPLY, a=p2_s.result, b=p2_s.result).result, b=0.2)
p3_dx = float_math(operation=SUBTRACT, a=xyz.x, b=1.299038)
p3_dy = float_math(operation=SUBTRACT, a=xyz.y, b=0.0)
p3_dz = float_math(operation=SUBTRACT, a=xyz.z, b=0.75)
p3_d2 = float_math(operation=ADD, a=float_math(operation=ADD, a=float_math(operation=MULTIPLY, a=p3_dx.result, b=p3_dx.result).result, b=float_math(operation=MULTIPLY, a=p3_dy.result, b=p3_dy.result).result).result, b=float_math(operation=MULTIPLY, a=p3_dz.result, b=p3_dz.result).result)
p3_s = float_math(operation=MAXIMUM, a=float_math(operation=SUBTRACT, a=1.0, b=float_math(operation=MULTIPLY, a=p3_d2.result, b=20.661157).result).result, b=0.0)
p3 = float_math(operation=MULTIPLY, a=float_math(operation=MULTIPLY, a=p3_s.result, b=p3_s.result).result, b=0.6)
p4_dx = float_math(operation=SUBTRACT, a=xyz.x, b=0.695288)
p4_dy = float_math(operation=SUBTRACT, a=xyz.y, b=-0.433013)
p4_dz = float_math(operation=SUBTRACT, a=xyz.z, b=2.139877)
p4_d2 = float_math(operation=ADD, a=float_math(operation=ADD, a=float_math(operation=MULTIPLY, a=p4_dx.result, b=p4_dx.result).result, b=float_math(operation=MULTIPLY, a=p4_dy.result, b=p4_dy.result).result).result, b=float_math(operation=MULTIPLY, a=p4_dz.result, b=p4_dz.result).result)
p4_s = float_math(operation=MAXIMUM, a=float_math(operation=SUBTRACT, a=1.0, b=float_math(operation=MULTIPLY, a=p4_d2.result, b=11.111111).result).result, b=0.0)
p4 = float_math(operation=MULTIPLY, a=float_math(operation=MULTIPLY, a=p4_s.result, b=p4_s.result).result, b=0.35)
p5_dx = float_math(operation=SUBTRACT, a=xyz.x, b=-1.863796)
p5_dy = float_math(operation=SUBTRACT, a=xyz.y, b=0.25)
p5_dz = float_math(operation=SUBTRACT, a=xyz.z, b=1.56391)
p5_d2 = float_math(operation=ADD, a=float_math(operation=ADD, a=float_math(operation=MULTIPLY, a=p5_dx.result, b=p5_dx.result).result, b=float_math(operation=MULTIPLY, a=p5_dy.result, b=p5_dy.result).result).result, b=float_math(operation=MULTIPLY, a=p5_dz.result, b=p5_dz.result).result)
p5_s = float_math(operation=MAXIMUM, a=float_math(operation=SUBTRACT, a=1.0, b=float_math(operation=MULTIPLY, a=p5_d2.result, b=11.111111).result).result, b=0.0)
p5 = float_math(operation=MULTIPLY, a=float_math(operation=MULTIPLY, a=p5_s.result, b=p5_s.result).result, b=0.5)
p6_dx = float_math(operation=SUBTRACT, a=xyz.x, b=1.664349)
p6_dy = float_math(operation=SUBTRACT, a=xyz.y, b=-0.433013)
p6_dz = float_math(operation=SUBTRACT, a=xyz.z, b=0.54078)
p6_d2 = float_math(operation=ADD, a=float_math(operation=ADD, a=float_math(operation=MULTIPLY, a=p6_dx.result, b=p6_dx.result).result, b=float_math(operation=MULTIPLY, a=p6_dy.result, b=p6_dy.result).result).result, b=float_math(operation=MULTIPLY, a=p6_dz.result, b=p6_dz.result).result)
p6_s = float_math(operation=MAXIMUM, a=float_math(operation=SUBTRACT, a=1.0, b=float_math(operation=MULTIPLY, a=p6_d2.result, b=16.0).result).result, b=0.0)
p6 = float_math(operation=MULTIPLY, a=float_math(operation=MULTIPLY, a=p6_s.result, b=p6_s.result).result, b=0.3)
p7_dx = float_math(operation=SUBTRACT, a=xyz.x, b=-0.662237)
p7_dy = float_math(operation=SUBTRACT, a=xyz.y, b=0.25)
p7_dz = float_math(operation=SUBTRACT, a=xyz.z, b=1.420173)
p7_d2 = float_math(operation=ADD, a=float_math(operation=ADD, a=float_math(operation=MULTIPLY, a=p7_dx.result, b=p7_dx.result).result, b=float_math(operation=MULTIPLY, a=p7_dy.result, b=p7_dy.result).result).result, b=float_math(operation=MULTIPLY, a=p7_dz.result, b=p7_dz.result).result)
p7_s = float_math(operation=MAXIMUM, a=float_math(operation=SUBTRACT, a=1.0, b=float_math(operation=MULTIPLY, a=p7_d2.result, b=12.755102).result).result, b=0.0)
p7 = float_math(operation=MULTIPLY, a=float_math(operation=MULTIPLY, a=p7_s.result, b=p7_s.result).result, b=0.4)
p8_dx = float_math(operation=SUBTRACT, a=xyz.x, b=1.25)
p8_dy = float_math(operation=SUBTRACT, a=xyz.y, b=0.0)
p8_dz = float_math(operation=SUBTRACT, a=xyz.z, b=-2.165064)
p8_d2 = float_math(operation=ADD, a=float_math(operation=ADD, a=float_math(operation=MULTIPLY, a=p8_dx.result, b=p8_dx.result).result, b=float_math(operation=MULTIPLY, a=p8_dy.result, b=p8_dy.result).result).result, b=float_math(operation=MULTIPLY, a=p8_dz.result, b=p8_dz.result).result)
p8_s = float_math(operation=MAXIMUM, a=float_math(operation=SUBTRACT, a=1.0, b=float_math(operation=MULTIPLY, a=p8_d2.result, b=8.163265).result).result, b=0.0)
p8 = float_math(operation=MULTIPLY, a=float_math(operation=MULTIPLY, a=p8_s.result, b=p8_s.result).result, b=0.45)
pits_2 = float_math(operation=ADD, a=p1.result, b=p2.result)
pits_3 = float_math(operation=ADD, a=pits_2.result, b=p3.result)
pits_4 = float_math(operation=ADD, a=pits_3.result, b=p4.result)
pits_5 = float_math(operation=ADD, a=pits_4.result, b=p5.result)
pits_6 = float_math(operation=ADD, a=pits_5.result, b=p6.result)
pits_7 = float_math(operation=ADD, a=pits_6.result, b=p7.result)
pits_8 = float_math(operation=ADD, a=pits_7.result, b=p8.result)

# --- Press the tube toward its centre circle: the groove by up to 0.3 of its radius, each pit by its depth ---
groove_depth = float_math(operation=MULTIPLY, a=pinch.result, b=0.3)
inward = float_math(operation=ADD, a=groove_depth.result, b=pits_8.result)
depth = float_math(operation=MULTIPLY, a=inward.result, b=-1.0)
disp_x = float_math(operation=MULTIPLY, a=tx.result, b=depth.result)
disp_y = float_math(operation=MULTIPLY, a=xyz.y, b=depth.result)
disp_z = float_math(operation=MULTIPLY, a=tz.result, b=depth.result)
displacement = combine_xyz(x=disp_x.result, y=disp_y.result, z=disp_z.result)
pocked = set_position(geometry=carrier.mesh, offset=displacement.vector)
surface = surface_metric(geometry=pocked.geometry)
creases = surface_creases(geometry=surface.geometry)
ring_00 = spline_ring(geometry=creases.geometry, metric=surface.metric, points="0.000000,0.000000,2.500000; 0.000000,-0.445503,2.226995; 0.000000,-0.445503,1.773005; 0.000000,0.000000,1.500000; 0.000000,0.445503,1.773005; 0.000000,0.445503,2.226995", normal="-0.999690,-0.016898,-0.018303", label="ring_00")
