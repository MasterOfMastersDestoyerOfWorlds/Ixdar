# Merged cell slot: a collapse that must resolve covers into a merged cell's slot.
carrier = mesh_disk(rings=5, angular_segments=12, radius=5.0, triangulate=true)
network = arc_network(mesh=carrier.mesh)
survivorNodeId = network_node(net=network.net, point=<0.0, 0.0, 0.0>, critical=true)
movedNodeId = network_node(net=network.net, point=<0.0, 0.0, 2.0>)
baitFixedNodeId = network_node(net=network.net, point=<2.0, 0.0, 0.0>)
n3 = network_node(net=network.net, point=<1.7320508, 0.0, -1.0>)
n4 = network_node(net=network.net, point=<0.0, 0.0, -2.0>)
n5 = network_node(net=network.net, point=<0.0, 0.0, 4.0>)
channelArcId = network_arc(net=network.net, from=movedNodeId.id, to=survivorNodeId.id)
baitArcId = network_arc(net=network.net, from=movedNodeId.id, to=baitFixedNodeId.id, length=1)
nearSealArcId = network_arc(net=network.net, from=baitFixedNodeId.id, to=survivorNodeId.id, length=1, via1=<0.5, 0.0, 0.8660254>)
bufferFarArcId = network_arc(net=network.net, from=baitFixedNodeId.id, to=n3.id, length=1)
bufferSealArcId = network_arc(net=network.net, from=n3.id, to=survivorNodeId.id, length=1, via1=<1.0, 0.0, 0.0>)
farSealArcId = network_arc(net=network.net, from=n4.id, to=survivorNodeId.id, length=1)
bandBackArcId = network_arc(net=network.net, from=n4.id, to=n5.id, length=1, via1=<0.0, 0.0, -4.0>, via2=<3.4641016, 0.0, -2.0>, via3=<3.4641016, 0.0, 2.0>)
tailArcId = network_arc(net=network.net, from=movedNodeId.id, to=n5.id, length=1)
nearPatchId = network_patch(net=network.net, a=movedNodeId.id, b=survivorNodeId.id, c=baitFixedNodeId.id, d=movedNodeId.id)
bufferPatchId = network_patch(net=network.net, a=survivorNodeId.id, b=n3.id, c=baitFixedNodeId.id, d=survivorNodeId.id)
farPatchId = network_patch(net=network.net, a=movedNodeId.id, b=baitFixedNodeId.id, c=survivorNodeId.id, d=n4.id)
outerPatchId = network_patch(net=network.net, a=survivorNodeId.id, b=movedNodeId.id, c=n5.id, d=n4.id)
