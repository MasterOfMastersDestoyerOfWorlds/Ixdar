# Fan collapse: a zero spoke whose collapse drags a twelve-arc fan onto the center.
carrier = mesh_disk(rings=5, angular_segments=24, radius=5.0, triangulate=true)
network = arc_network(mesh=carrier.mesh)
centerNodeId = network_node(net=network.net, point=<0.0, 0.0, 0.0>)
boxNodeIdByHour0 = network_node(net=network.net, point=<0.0, 0.0, 4.0>, critical=true)
boxNodeIdByHour1 = network_node(net=network.net, point=<2.0, 0.0, 3.4641016>)
boxNodeIdByHour2 = network_node(net=network.net, point=<3.4641016, 0.0, 2.0>)
boxNodeIdByHour3 = network_node(net=network.net, point=<4.0, 0.0, 0.0>)
boxNodeIdByHour4 = network_node(net=network.net, point=<3.4641016, 0.0, -2.0>)
boxNodeIdByHour5 = network_node(net=network.net, point=<2.0, 0.0, -3.4641016>)
boxNodeIdByHour6 = network_node(net=network.net, point=<0.0, 0.0, -4.0>)
boxNodeIdByHour7 = network_node(net=network.net, point=<-2.0, 0.0, -3.4641016>)
boxNodeIdByHour8 = network_node(net=network.net, point=<-3.4641016, 0.0, -2.0>)
boxNodeIdByHour9 = network_node(net=network.net, point=<-4.0, 0.0, 0.0>)
boxNodeIdByHour10 = network_node(net=network.net, point=<-3.4641016, 0.0, 2.0>)
boxNodeIdByHour11 = network_node(net=network.net, point=<-2.0, 0.0, 3.4641016>)
zeroSpokeArcId = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour0.id)
spokeArcIdByHour1 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour1.id, length=1)
spokeArcIdByHour2 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour2.id, length=1)
spokeArcIdByHour3 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour3.id, length=1)
spokeArcIdByHour4 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour4.id, length=1)
spokeArcIdByHour5 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour5.id, length=1)
spokeArcIdByHour6 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour6.id, length=1)
spokeArcIdByHour7 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour7.id, length=1)
spokeArcIdByHour8 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour8.id, length=1)
spokeArcIdByHour9 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour9.id, length=1)
spokeArcIdByHour10 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour10.id, length=1)
spokeArcIdByHour11 = network_arc(net=network.net, from=centerNodeId.id, to=boxNodeIdByHour11.id, length=1)
boxArcIdByHour0 = network_arc(net=network.net, from=boxNodeIdByHour0.id, to=boxNodeIdByHour1.id, length=1)
boxArcIdByHour1 = network_arc(net=network.net, from=boxNodeIdByHour1.id, to=boxNodeIdByHour2.id, length=1)
boxArcIdByHour2 = network_arc(net=network.net, from=boxNodeIdByHour2.id, to=boxNodeIdByHour3.id, length=1)
boxArcIdByHour3 = network_arc(net=network.net, from=boxNodeIdByHour3.id, to=boxNodeIdByHour4.id, length=1)
boxArcIdByHour4 = network_arc(net=network.net, from=boxNodeIdByHour4.id, to=boxNodeIdByHour5.id, length=1)
boxArcIdByHour5 = network_arc(net=network.net, from=boxNodeIdByHour5.id, to=boxNodeIdByHour6.id, length=1)
boxArcIdByHour6 = network_arc(net=network.net, from=boxNodeIdByHour6.id, to=boxNodeIdByHour7.id, length=1)
boxArcIdByHour7 = network_arc(net=network.net, from=boxNodeIdByHour7.id, to=boxNodeIdByHour8.id, length=1)
boxArcIdByHour8 = network_arc(net=network.net, from=boxNodeIdByHour8.id, to=boxNodeIdByHour9.id, length=1)
boxArcIdByHour9 = network_arc(net=network.net, from=boxNodeIdByHour9.id, to=boxNodeIdByHour10.id, length=1)
boxArcIdByHour10 = network_arc(net=network.net, from=boxNodeIdByHour10.id, to=boxNodeIdByHour11.id, length=1)
boxArcIdByHour11 = network_arc(net=network.net, from=boxNodeIdByHour11.id, to=boxNodeIdByHour0.id, length=1)
p0 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour1.id, c=boxNodeIdByHour0.id, d=centerNodeId.id)
p1 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour2.id, c=boxNodeIdByHour1.id, d=centerNodeId.id)
p2 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour3.id, c=boxNodeIdByHour2.id, d=centerNodeId.id)
p3 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour4.id, c=boxNodeIdByHour3.id, d=centerNodeId.id)
p4 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour5.id, c=boxNodeIdByHour4.id, d=centerNodeId.id)
p5 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour6.id, c=boxNodeIdByHour5.id, d=centerNodeId.id)
p6 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour7.id, c=boxNodeIdByHour6.id, d=centerNodeId.id)
p7 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour8.id, c=boxNodeIdByHour7.id, d=centerNodeId.id)
p8 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour9.id, c=boxNodeIdByHour8.id, d=centerNodeId.id)
p9 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour10.id, c=boxNodeIdByHour9.id, d=centerNodeId.id)
p10 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour11.id, c=boxNodeIdByHour10.id, d=centerNodeId.id)
p11 = network_patch(net=network.net, a=centerNodeId.id, b=boxNodeIdByHour0.id, c=boxNodeIdByHour11.id, d=centerNodeId.id)
p12 = network_patch(net=network.net, a=boxNodeIdByHour0.id, b=boxNodeIdByHour0.id, c=boxNodeIdByHour0.id, d=boxNodeIdByHour0.id, first_side=12, second_side=0, third_side=0, fourth_side=0)
