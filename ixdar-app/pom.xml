                <argument>-XX:ErrorFile=target/hs_err_pid%p.log</argument>
                <argument>-classpath</argument>
                <classpath />
                <argument>-Ddsl.export=${dsl.export}</argument>
                <argument>-Dskill.dir=${skill.dir}</argument>
                <argument>ixdar.geometry.mesh.documentation.ValidateDsl</argument>
                <argument>${dsl.file}</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>batch-dsl</id>
      <properties>
        <maven.test.skip>true</maven.test.skip>
      </properties>
      <build>
        <defaultGoal>compile exec:exec</defaultGoal>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.2</version>
            <configuration>
              <executable>java</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-XX:ErrorFile=target/hs_err_pid%p.log</argument>
                <argument>-classpath</argument>
                <classpath />
                <argument>ixdar.geometry.mesh.documentation.BatchDslEvaluator</argument>
                <argument>${dsl.file}</argument>
                <argument>${batch.arg1}</argument>
                <argument>${batch.arg2}</argument>
                <argument>${batch.arg3}</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>${native.maven.plugin.version}</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <imageName>gvapp</imageName>
              <mainClass>ixdar.canvas.IxdarWindow</mainClass>
              <verbose>true</verbose>
            </configuration>
          </plugin>
        </plugins>
      </build>
