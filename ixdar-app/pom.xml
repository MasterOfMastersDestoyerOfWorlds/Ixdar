<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>IXDAR</groupId>
    <artifactId>IXDAR-parent</artifactId>
    <version>0.0.1</version>
  </parent>

  <artifactId>ixdar-app</artifactId>
  <version>0.0.1</version>
  <packaging>jar</packaging>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>test</testSourceDirectory>

    <!--
      Only the service registration, kept in its own directory so it lands at the classpath root
      where the JUnit launcher looks. test/resources holds nested fixture data and must stay nested.
    -->
    <testResources>
      <testResource>
        <directory>test/spi</directory>
      </testResource>
    </testResources>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/*.ix</include>
          <include>**/*.vs</include>
          <include>**/*.fs</include>
          <include>**/*.json</include>
          <include>**/*.png</include>
          <include>**/*.webp</include>
          <include>**/*.ico</include>
          <include>**/*.html</include>
          <include>**/*.wav</include>
          <include>**/*.dsl</include>
        </includes>
      </resource>
      <resource>
        <directory>${ixdar.asset.repo.root}/Music</directory>
        <includes>
          <include>${ixdar.audio.asset.include.pattern}</include>
        </includes>
        <targetPath>res/audio/music</targetPath>
      </resource>
      <resource>
        <directory>${ixdar.asset.repo.root}/Sfx</directory>
        <includes>
          <include>${ixdar.audio.asset.include.pattern}</include>
        </includes>
        <targetPath>res/audio/sfx</targetPath>
      </resource>
    </resources>
    <plugins>

      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>25</release>
          <annotationProcessorPaths>
            <path>
              <groupId>IXDAR</groupId>
              <artifactId>annotations</artifactId>
              <version>0.0.1</version>
            </path>
          </annotationProcessorPaths>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <mainClass>ixdar.canvas.IxdarWindow</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>create-my-bundle</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptorRefs>
                <descriptorRef>jar-with-dependencies</descriptorRef>
              </descriptorRefs>
              <archive>
                <manifest>
                  <addClasspath>true</addClasspath>
                  <mainClass>ixdar.canvas.IxdarWindow</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <version>2.4</version>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
          <release>25</release>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <mainClass>ixdar.canvas.IxdarWindow</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!--
          Regenerate the automation routes manifest on every build so the committed copy the Python CLI
          reads (ixdar_automation_cli/automation_routes.json) is always current. Output is deterministic
          (sorted), so a no-op build leaves it byte-identical.
        -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>export-automation-routes</id>
            <phase>compile</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <!--
                compile, not the default runtime: the web-teavm profile re-declares gson and the
                LWJGL stack as provided, which the runtime classpath drops.
              -->
              <classpathScope>compile</classpathScope>
              <mainClass>ixdar.platform.automation.documentation.ExportAutomationRoutes</mainClass>
              <arguments>
                <argument>${project.basedir}/../ixdar_automation_cli/automation_routes.json</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>

  </build>

  <properties>
    <lwjgl.version>3.3.6</lwjgl.version>
    <mkl.version>2025.0-1.5.11</mkl.version>
    <native.maven.plugin.version>0.9.19</native.maven.plugin.version>
    <teavm.version>0.15.0</teavm.version>
    <ixdar.audio.asset.include.pattern>**/*.wav</ixdar.audio.asset.include.pattern>
    <ixdar.asset.repo.root>${project.basedir}/../../IxdarAssets</ixdar.asset.repo.root>
  </properties>

  <repositories>
    <!-- manifold3d's Java bindings publish here, not to Maven Central. -->
    <repository>
      <id>clojars</id>
      <name>Clojars</name>
      <url>https://repo.clojars.org</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>graalvm-native-build-tools-snapshots</id>
      <name>GraalVM native-build-tools Snapshots</name>
      <url>https://raw.githubusercontent.com/graalvm/native-build-tools/snapshots</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <profiles>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>Windows</family>
        </os>
      </activation>
      <properties>
        <lwjgl.natives>natives-windows</lwjgl.natives>
      </properties>
      <!-- MKL ships no mac artifacts, so the PARDISO natives are per-OS
           profile dependencies instead of a ${...} classifier like LWJGL;
           on mac the solver falls back to the pure-Java EJML backend. -->
      <dependencies>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>mkl</artifactId>
          <version>${mkl.version}</version>
          <classifier>windows-x86_64</classifier>
        </dependency>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>mkl</artifactId>
          <version>${mkl.version}</version>
          <classifier>windows-x86_64-redist</classifier>
        </dependency>
      </dependencies>
    </profile>
