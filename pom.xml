<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>IXDAR</groupId>
  <artifactId>IXDAR-parent</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>
  <properties>
    <!--
      Tells m2e-apt (inside VS Code's Java language server) to run the annotation processors during
      IDE builds. Without it the IDE's target-ide tree lacks the generated registries
      (SceneRegistry_Scenes, MeshNodeRegistry_MeshNodes, ...), and IDE-launched scenes die with
      a null CanvasSceneMap.MAP. Plain Maven ignores the property.
    -->
    <m2e.apt.activation>jdt_apt</m2e.apt.activation>
  </properties>

  <modules>
    <module>annotations</module>
    <module>ixdar-app</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <failOnViolation>true</failOnViolation>
          <outputFileFormat>xml</outputFileFormat>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>10.20.1</version>
          </dependency>
          <dependency>
            <groupId>IXDAR</groupId>
            <artifactId>autofix-tool</artifactId>
            <version>0.0.1</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>checkstyle-validate</id>
            <phase>process-sources</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>autofix</id>
      <dependencies>
        <dependency>
          <groupId>IXDAR</groupId>
          <artifactId>autofix-tool</artifactId>
          <version>0.0.1</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <executions>
              <execution>
                <id>checkstyle-report</id>
                <phase>initialize</phase>
                <goals>
                  <goal>checkstyle</goal>
                </goals>
                <configuration>
                  <failOnViolation>false</failOnViolation>
                  <outputFile>${project.build.directory}/checkstyle-result.xml</outputFile>
                  <outputFileFormat>xml</outputFileFormat>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>run-autofix</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>ixdar.autofix.Autofix</mainClass>
                  <arguments>
                    <argument>${project.build.directory}/checkstyle-result.xml</argument>
                    <argument>${project.basedir}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      One-shot single-caller helper sweep. Not part of the normal build: a helper having one
      caller is a style smell, not a build error, and running this every time would fight anyone
      who just wrote one deliberately. Narrow it with -Dinline.helpers.package to keep the diff
      reviewable, e.g. -Dinline.helpers.package=ixdar/geometry/mesh/quadlayout/embedding
    -->
    <profile>
      <id>inline-helpers</id>
      <properties>
        <inline.helpers.package></inline.helpers.package>
      </properties>
      <dependencies>
        <dependency>
          <groupId>IXDAR</groupId>
          <artifactId>autofix-tool</artifactId>
          <version>0.0.1</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>run-inline-helpers</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>ixdar.autofix.InlineHelpers</mainClass>
                  <arguments>
                    <argument>${project.basedir}</argument>
                    <argument>${inline.helpers.package}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        Active only inside the Eclipse JDT language server (m2e defines m2e.version), which VS Code's
        Java autobuild runs on. Redirects the IDE's whole build tree so its continuous compilation
        never races command-line Maven over target/classes - concurrent writes there corrupt class
        files (ClassFormatError: extra bytes) and break mvn clean mid-run.
      -->
      <id>m2e-ide-build</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <build>
        <directory>${project.basedir}/target-ide</directory>
      </build>
    </profile>
  </profiles>
</project>